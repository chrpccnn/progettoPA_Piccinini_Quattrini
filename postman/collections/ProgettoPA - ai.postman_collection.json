    {
      "name": "state",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// per salvare le navi in variabili d'ambiente\r\nconst jsonResponse = pm.response.json();\r\n\r\njsonResponse.players.forEach(player => {\r\n    if (player.you) {\r\n        const counters = {};\r\n\r\n        player.ships.forEach(ship => {\r\n            counters[ship.type] = (counters[ship.type] || 0) + 1;\r\n\r\n            const variableName = `shipId_${ship.type}_${counters[ship.type]}`;\r\n\r\n            pm.environment.set(variableName, ship.id);\r\n        });\r\n    }\r\n});\r\n\r\nconsole.log(\"Game:\", jsonResponse.gameId);\r\nconsole.log(\"State:\", jsonResponse.state);\r\nconsole.log(\"Turn:\", jsonResponse.turn);\r\nconsole.log(\"Current player:\", jsonResponse.currentPlayer);\r\nconsole.log(\"Pending action:\", jsonResponse.pendingAction ?? \"none\");"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{JWT}}",
              "type": "string"
            }
          ]
        },
