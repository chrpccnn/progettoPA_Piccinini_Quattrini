    {
      "name": "state",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonResponse = pm.response.json();\r\n\r\njsonResponse.players.forEach(player => {\r\n    if (player.you) {\r\n        const counters = {};\r\n\r\n        player.ships.forEach(ship => {\r\n            counters[ship.type] = (counters[ship.type] || 0) + 1;\r\n\r\n            const variableName = `shipId_${ship.type}_${counters[ship.type]}`;\r\n\r\n            pm.environment.set(variableName, ship.id);\r\n        });\r\n    }\r\n});"
            ]
          }
        }
      ],
