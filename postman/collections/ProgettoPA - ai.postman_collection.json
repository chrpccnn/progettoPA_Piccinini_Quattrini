    {
      "name": "Create Game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {\r\n    const jsonResponse = pm.response.json();\r\n    pm.environment.set(\"GAMEID\", jsonResponse.gameId);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{JWT}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"mode\": \"ai\",\r\n  \"grid\": {\r\n    \"grid_base\": 10,\r\n    \"grid_height\": 5\r\n  },\r\n  \"ships\": {\r\n    \"motherShip\": 1,\r\n    \"cruiser\": 1,\r\n    \"scout\": 2,\r\n    \"drone\": 3\r\n  },\r\n  \"orientation\": [\r\n    \"HORIZONTAL\",\r\n    \"VERTICAL\",\r\n    \"DEPTH\"\r\n  ],\r\n  \"placements\": {\r\n    \"motherShip\": [\r\n      {\r\n        \"x\": 0,\r\n        \"y\": 0,\r\n        \"z\": 0,\r\n        \"orientation\": \"HORIZONTAL\"\r\n      }\r\n    ],\r\n    \"cruiser\": [\r\n      {\r\n        \"x\": 0,\r\n        \"y\": 2,\r\n        \"z\": 0,\r\n        \"orientation\": \"HORIZONTAL\"\r\n      }\r\n    ],\r\n    \"scout\": [\r\n      {\r\n        \"x\": 0,\r\n        \"y\": 4,\r\n        \"z\": 0,\r\n        \"orientation\": \"HORIZONTAL\"\r\n      },\r\n      {\r\n        \"x\": 0,\r\n        \"y\": 6,\r\n        \"z\": 0,\r\n        \"orientation\": \"HORIZONTAL\"\r\n      }\r\n    ],\r\n    \"drone\": [\r\n      {\r\n        \"x\": 0,\r\n        \"y\": 8,\r\n        \"z\": 0,\r\n        \"orientation\": \"HORIZONTAL\"\r\n      },\r\n      {\r\n        \"x\": 2,\r\n        \"y\": 8,\r\n        \"z\": 0,\r\n        \"orientation\": \"HORIZONTAL\"\r\n      },\r\n      {\r\n        \"x\": 4,\r\n        \"y\": 8,\r\n        \"z\": 0,\r\n        \"orientation\": \"HORIZONTAL\"\r\n      }\r\n    ]\r\n  }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://{{HOST}}:{{PORT}}/game",
          "protocol": "http",
          "host": [
