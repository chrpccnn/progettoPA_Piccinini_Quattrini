    {
      "name": "State",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonResponse = pm.response.json();\n\njsonResponse.players.forEach(player => {\n    if (player.you) {\n        const counters = {};\n\n        player.ships.forEach(ship => {\n            counters[ship.type] = (counters[ship.type] || 0) + 1;\n            const variableName = `shipId_${ship.type}_${counters[ship.type]}`;\n            pm.environment.set(variableName, ship.id);\n        });\n    }\n});\n\nconsole.log(\"State:\", jsonResponse.state);\nconsole.log(\"Turn:\", jsonResponse.turn);\nconsole.log(\"Current player:\", jsonResponse.currentPlayer);\nconsole.log(\"Pending action:\", jsonResponse.pendingAction ?? \"none\");"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{JWT}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://{{HOST}}:{{PORT}}/game/{{GAMEID}}/state",
          "protocol": "http",
          "host": [
            "{{HOST}}"
          ],
          "port": "{{PORT}}",
          "path": [
            "game",
            "{{GAMEID}}",
            "state"
          ]
        }
      },
      "response": []
    },
